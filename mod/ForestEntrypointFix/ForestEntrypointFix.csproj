<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx preloader patcher (goes to BepInEx/patchers): picks the right Unity entrypoint assembly for whichever
       of The Forest's builds (flat-screen Unity 5.6 / VR Unity 2017.4) is starting. See ForestEntrypointFix.cs. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ForestEntrypointFix</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\tools\downloads\BepInEx_win_x64_5.4.23.6\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCore)\Mono.Cecil.dll" Private="false" />
  </ItemGroup>
</Project>
