<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>VrTweaks</AssemblyName>
    <RootNamespace>VrTweaks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- The Forest install folder: set the GAME_DIR environment variable, or pass -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">$(GAME_DIR)</GameDir>
    <!-- Compiled against the flat-screen build; VR-only members are resolved by name at runtime. -->
    <GameManaged>$(GameDir)\TheForest_Data\Managed</GameManaged>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\tools\downloads\BepInEx_win_x64_5.4.23.6\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set the GAME_DIR environment variable (or -p:GameDir=...) to The Forest's install folder." />
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in '$(GameManaged)'. Check GAME_DIR." />
  </Target>

  <ItemGroup>
    <!-- The twist arrow, rendered by scripts/chalk-icons.html. -->
    <EmbeddedResource Include="Icons\*.png" LogicalName="VrTweaks.Icons.%(Filename)%(Extension)" />
    <!-- PNG reading, shared with ArrowFixes. -->
    <Compile Include="..\ArrowFixes\PngMask.cs" Link="PngMask.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="bolt" HintPath="$(GameManaged)\bolt.dll" Private="false" />
    <Reference Include="bolt.user" HintPath="$(GameManaged)\bolt.user.dll" Private="false" />
  </ItemGroup>

</Project>
