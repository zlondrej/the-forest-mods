<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the plugin's generated art outside the game: cloth wraps as OBJ (for scripts/render_cloth_preview.py)
       and arrow-type HUD icons as PNG. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\mod\ArrowFixes\ClothWrapBuilder.cs" Link="ClothWrapBuilder.cs" />
    <Compile Include="..\..\mod\ArrowFixes\ClothWrapSpecs.cs" Link="ClothWrapSpecs.cs" />
    <Compile Include="..\..\mod\ArrowFixes\ArrowIconPainter.cs" Link="ArrowIconPainter.cs" />
    <Compile Include="..\..\mod\ArrowFixes\PngMask.cs" Link="PngMask.cs" />
    <EmbeddedResource Include="..\..\mod\ArrowFixes\Icons\*.png" LogicalName="ArrowFixes.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
